{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"width": "container",
"height": "container",

"title": "How are threatened are species in each state?",

"config": {
    "title": {
        "fontSize": 18,
        "fontWeight":"bold"
    },

    "legend": {
        "titleFontSize": 14,
        "titleFontWeight": "bold",
        "labelFontSize": 14
    },

    "axis": {
        "labelFontSize": 12,   
        "titleFontSize": 12,   
        "titleFontWeight": "bold",
        "labelFont": "Open Sans",
        "titleFont": "Open Sans"
    },

    "view": {
        "stroke": null
    }
},

"data": {"url": "https://raw.githubusercontent.com/L-u-c-a-s-C/FIT3179/refs/heads/main/tsx_no_time_series.csv"},

"transform": [
   {"filter": "datum.State != 'Commonwealth'"},

   {
        "aggregate": [{"op": "count", "as": "Count"}], 
        "groupby": ["State", "MaxStatus"]
    },

   {
        "joinaggregate": [{"op": "sum", "field": "Count", "as": "TotalPerState"}],
        "groupby": ["State"]
   },

   {
        "calculate": "datum.Count / datum.TotalPerState",
        "as": "ProportionPerState"
   },

   {
        "calculate": 
            "datum.MaxStatus == 'Near Threatened' ? 4 : (datum.MaxStatus == 'Vulnerable' ? 3 : (datum.MaxStatus == 'Endangered' ? 2 : 1))",
        "as": "OrderValues"
   }
],

"mark": "bar",

"encoding": {
    "x": {
        "field": "State",
        "type": "nominal",
        "title": null,
        "axis": {
            "labelAngle": -30
        },

        "scale": {
            "domain": ["Victoria", "New South Wales", "Northern Territory", "Queensland", "South Australia", "Tasmania", "Western Australia", "Australian Capital Territory"]
        }
    },

    "y": {
        "field":"ProportionPerState",
        "type": "quantitative", 
        "axis": {"title": null, "format": "%"},
        "scale": {"domain": [0, 1]}
    },

    "color": {
        "field": "MaxStatus",
        "type": "nominal",

        "scale": {
            "domain": ["Near Threatened", "Vulnerable", "Endangered", "Critically Endangered"],
            "range": ["#fef0d9", "#fdcc8a", "#fc8d59", "#d7301f"]
        },

        "legend": {"title": "Threatened Status"}
    },

    "order": {
        "field": "OrderValues",
        "type": "quantitative",
        "sort": "ascending"
    },    

    "tooltip": [
        {"field": "State", "type": "nominal"},
        {"field": "MaxStatus", "type": "nominal", "title": "Status"},
        {"field": "ProportionPerState", "type": "quantitative", "title": "Proportion", "format": ".2%"}
    ]
}
}
